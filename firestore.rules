rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isDoctor() {
      return isSignedIn() && (
        (request.auth.token.role == 'doctor') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['doctor', 'patient'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('facility' in data) || (data.facility is string && data.facility.size() <= 120)) &&
             (!('licenseOrPatientId' in data) || (data.licenseOrPatientId is string && data.licenseOrPatientId.size() <= 64));
    }

    // -------------------------------------------------------------
    // User Accounts Profile Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isDoctor());
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) && incoming().uid == resource.data.uid && isValidUser(incoming());
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Patient Records Collection (HIPAA / Zero-Trust Scoped)
    // -------------------------------------------------------------
    match /patients/{patientId} {
      // Patients may only read their own records; verified doctors may read for clinical triage
      allow read: if isSignedIn() && (
        isOwner(patientId) ||
        (resource != null && resource.data.patientId == request.auth.uid) ||
        isDoctor()
      );

      // Only the patient owner or an authorized attending doctor can update clinical records
      allow create: if isSignedIn() && isValidId(patientId) && (
        isOwner(patientId) ||
        isDoctor()
      );

      allow update: if isSignedIn() && isValidId(patientId) && (
        isOwner(patientId) ||
        (resource != null && resource.data.patientId == request.auth.uid) ||
        isDoctor()
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Immutable Cryptographic Audit Logs Collection
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      // Audit logs are visible only to the patient whose record was accessed or the attending physician
      allow read: if isSignedIn() && (
        (resource != null && (resource.data.patientId == request.auth.uid || resource.data.accessorUid == request.auth.uid)) ||
        isDoctor()
      );

      // Append-only: any authenticated session can record a verifiable access event
      allow create: if isSignedIn() && isValidId(logId) && incoming().keys().hasAll(['id', 'eventType', 'timestamp']);
      
      // Strict Tamper-Resistance: Audit logs can NEVER be altered or deleted
      allow update, delete: if false;
    }
  }
}
