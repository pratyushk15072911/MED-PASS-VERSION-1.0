rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['doctor', 'patient'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('facility' in data) || (data.facility is string && data.facility.size() <= 120)) &&
             (!('licenseOrPatientId' in data) || (data.licenseOrPatientId is string && data.licenseOrPatientId.size() <= 64));
    }

    // User Accounts Profile Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) && incoming().uid == existing().uid && isValidUser(incoming());
      allow delete: if false;
    }

    // Patient Records Collection
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(patientId);
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
